#!/usr/bin/env python3

"""
CotMate
=======

An rmate-compatible TCP server for CotEditor on macOS.

Protocol:
    rmate client  --->  CotMate  --->  local mirror  --->  CotEditor

When CotEditor modifies the local mirror, CotMate sends the changed
contents back to the rmate client using the rmate "save" command.

No sudo is required or used.

Default listener:
    127.0.0.1:52698

Requires Python 3.9+ (the version shipped by Xcode Command Line Tools
on macOS Monterey and every later release).
"""

from __future__ import annotations

import argparse
import os
import pathlib
import platform
import shutil
import signal
import socket
import subprocess
import threading
import time
import uuid
from typing import Dict, Optional, Tuple

# ---------------------------------------------------------------------------
# Version
# ---------------------------------------------------------------------------

__version__ = "1.2.2"

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------

DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 52698
DEFAULT_POLL_INTERVAL = 0.25


def default_base_dir() -> pathlib.Path:
    """Return CotMate's standard runtime directory."""

    return (
            pathlib.Path.home()
            / "Library"
            / "Application Support"
            / "CotMate"
    )


# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

class Config:
    """
    Runtime configuration.

    Built once from CLI arguments in main() and passed to everything
    that needs it.  Keeping this explicit (rather than reading module
    globals) is what makes the rest of the code testable.
    """

    def __init__(
            self,
            host: str = DEFAULT_HOST,
            port: int = DEFAULT_PORT,
            base_dir: Optional[pathlib.Path] = None,
            poll_interval: float = DEFAULT_POLL_INTERVAL,
    ):
        self.host = host
        self.port = port
        self.base_dir = (
            pathlib.Path(base_dir)
            if base_dir is not None
            else default_base_dir()
        )
        self.mirrors_dir = self.base_dir / "mirrors"
        self.poll_interval = poll_interval

    @classmethod
    def from_args(cls, args: argparse.Namespace) -> "Config":
        return cls(host=args.host, port=args.port)


# ---------------------------------------------------------------------------
# Utilities
# ---------------------------------------------------------------------------

_MACOS_CODENAMES = {
    12: "Monterey",
    13: "Ventura",
    14: "Sonoma",
    15: "Sequoia",
    26: "Tahoe",
}


def macos_codename(release: str) -> str:
    """Return the marketing name for a Darwin release, if known."""
    try:
        major = int(release.split(".", 1)[0])
    except (ValueError, AttributeError):
        return ""

    return _MACOS_CODENAMES.get(major, "")


def environment_report() -> str:
    """
    One-line summary of the runtime environment.

    Used only for the startup log, so a user reporting a bug can
    paste a single line that identifies everything we might need to
    reproduce their setup.
    """
    py_impl = platform.python_implementation()
    py_ver = platform.python_version()

    mac_ver, _, mac_arch = platform.mac_ver()
    codename = macos_codename(mac_ver)
    mac_bits = f"{mac_ver} {codename}".strip()
    if mac_arch:
        mac_bits = f"{mac_bits} ({mac_arch})"

    return (
        f"Python {py_ver} ({py_impl}) "
        f"on macOS {mac_bits}"
    )


def find_cot() -> str:
    """
    Find the normal CotEditor CLI.

    Prefer PATH so this uses the same `cot` command the user gets
    interactively.
    """

    # noinspection PyDeprecation
    cot = shutil.which("cot")

    if cot:
        return cot

    fallback = "/Applications/CotEditor.app/Contents/SharedSupport/bin/cot"

    if os.path.exists(fallback):
        return fallback

    raise FileNotFoundError(
        "Unable to find CotEditor CLI (`cot`). "
        "Make sure /usr/local/bin/cot exists or CotEditor is installed."
    )


def safe_host_name(display_name: str) -> str:
    """
    Convert the remote host portion into a filesystem-safe directory name.
    """

    host = display_name.split(":", 1)[0]

    return "".join(
        c if c.isalnum() or c in "._-" else "_"
        for c in host
    )


def cleanup_stale_mirrors(mirrors_dir: pathlib.Path) -> None:
    """
    Remove leftover mirror files from previous runs.

    Called once at server start.  At that moment nothing can legitimately
    be using anything under mirrors_dir, so it is safe to wipe the tree.
    """

    if not mirrors_dir.exists():
        return

    removed = 0

    for root, dirs, files in os.walk(mirrors_dir, topdown=False):
        for name in files:
            try:
                os.unlink(os.path.join(root, name))
                removed += 1
            except OSError:
                pass

        for name in dirs:
            try:
                os.rmdir(os.path.join(root, name))
            except OSError:
                pass

    if removed:
        print(
            f"[cotmate] cleaned {removed} stale mirror file(s)",
            flush=True,
        )


# ---------------------------------------------------------------------------
# Protocol reader
#
# Pure functions on a socket.  Kept out of any class because they have
# no state and are trivially testable as-is.
# ---------------------------------------------------------------------------

def read_line(sock: socket.socket) -> str:
    """
    Read one UTF-8 protocol line.

    Lines are terminated by LF. CR before LF is removed.
    """

    data = bytearray()

    while True:
        chunk = sock.recv(1)

        if not chunk:
            raise EOFError

        if chunk == b"\n":
            return bytes(data).decode("utf-8").rstrip("\r")

        data.extend(chunk)


def read_command(
        sock: socket.socket,
) -> Tuple[str, Dict[str, str], bytes]:
    """
    Read one rmate command.

    Returns:
        command
        headers
        body
    """

    command = read_line(sock)

    headers: Dict[str, str] = {}
    body = b""

    # The bash rmate client sends a bare "." as a handshake separator
    # with no header block and no blank terminator.  Short-circuit so
    # we don't block forever waiting for a blank line that never comes.
    if command == ".":
        return command, headers, body

    while True:
        line = read_line(sock)

        if line == "":
            break

        if ":" not in line:
            continue

        name, value = line.split(":", 1)
        value = value.lstrip()

        if name == "data":
            size = int(value)
            remaining = size
            chunks = []

            while remaining:
                chunk = sock.recv(min(65536, remaining))

                if not chunk:
                    raise EOFError

                chunks.append(chunk)
                remaining -= len(chunk)

            body = b"".join(chunks)
        else:
            headers[name] = value

    return command, headers, body


# ---------------------------------------------------------------------------
# Document registry
# ---------------------------------------------------------------------------

class DocumentRegistry:
    """
    Tracks currently-open remote documents, keyed by (host, real_path).

    Used to reject duplicate opens of the same remote file so two
    rmate sessions cannot silently fight over the same remote target
    (last-writer-wins).
    """

    def __init__(self):
        self._docs: Dict[Tuple[str, str], "RemoteDocument"] = {}
        self._lock = threading.Lock()

    def lookup(self, key: Tuple[str, str]) -> Optional["RemoteDocument"]:
        with self._lock:
            return self._docs.get(key)

    def try_register(
            self,
            key: Tuple[str, str],
            doc: "RemoteDocument",
    ) -> bool:
        """
        Atomically register doc under key, unless a live doc is
        already registered.  Returns True on success, False if a
        live doc is already present.
        """
        with self._lock:
            existing = self._docs.get(key)

            if existing is not None and not existing.closed:
                return False

            self._docs[key] = doc
            return True

    def unregister(
            self,
            key: Tuple[str, str],
            doc: "RemoteDocument",
    ) -> None:
        """
        Remove doc from the registry, but only if it is currently the
        registered doc for key.  This makes close() idempotent even
        if a duplicate registration raced in between.
        """
        with self._lock:
            if self._docs.get(key) is doc:
                del self._docs[key]


# ---------------------------------------------------------------------------
# Remote document
# ---------------------------------------------------------------------------

class RemoteDocument:
    """
    A single remote file materialised as a local mirror, plus the
    machinery to stream saves back to the originating rmate client.
    """

    def __init__(
            self,
            connection: socket.socket,
            token: str,
            display_name: str,
            real_path: str,
            data: bytes,
            config: Config,
            registry: DocumentRegistry,
            file_type: Optional[str] = None,
            line: Optional[int] = None,
            column: Optional[int] = None,
    ):
        self.connection = connection
        self.token = token

        self.display_name = display_name
        self.real_path = real_path

        self.config = config
        self.registry = registry

        self.file_type = file_type
        self.line = line
        self.column = column

        self.closed = False

        self.last_mtime: Optional[int] = None
        self.last_size: Optional[int] = None

        self.lock = threading.Lock()

        # ---------------------------------------------------------------
        # Build a local mirror path.
        # ---------------------------------------------------------------

        host_dir = safe_host_name(display_name)

        # Key used to register this document in the shared registry.
        self.registry_key: Tuple[str, str] = (host_dir, real_path)

        relative = pathlib.Path(real_path.lstrip("/"))

        self.local_dir = (
                config.mirrors_dir
                / host_dir
                / relative.parent
        )

        self.local_dir.mkdir(parents=True, exist_ok=True)

        # With duplicate opens rejected upstream, we should never see
        # an existing local path here.  Keep the UUID fallback anyway
        # as a belt-and-braces safety net.
        self.local_path = self.local_dir / relative.name

        if self.local_path.exists():
            self.local_path = (
                    self.local_dir
                    / (
                        f"{relative.name}."
                        f"cotmate-{uuid.uuid4().hex[:8]}"
                    )
            )

        self.local_path.write_bytes(data)
        self.update_stat()

    # ------------------------------------------------------------------
    # File state
    # ------------------------------------------------------------------

    def update_stat(self) -> None:
        try:
            stat = self.local_path.stat()
            self.last_mtime = stat.st_mtime_ns
            self.last_size = stat.st_size
        except FileNotFoundError:
            self.last_mtime = None
            self.last_size = None

    def changed(self) -> bool:
        try:
            stat = self.local_path.stat()
        except FileNotFoundError:
            return False

        return (
                stat.st_mtime_ns != self.last_mtime
                or stat.st_size != self.last_size
        )

    # ------------------------------------------------------------------
    # CotEditor
    # ------------------------------------------------------------------

    def open_in_cot(self) -> None:
        cot = find_cot()

        command = [cot]

        if self.file_type:
            command += ["--syntax", self.file_type]

        if self.line:
            command += ["--line", str(self.line)]

        if self.column:
            command += ["--column", str(self.column)]

        command.append(str(self.local_path))

        print("[cotmate] running:", " ".join(command), flush=True)

        # IMPORTANT: do not use sudo.
        #
        # CotMate runs as the logged-in GUI user, so CotEditor must
        # also be launched inside that user's GUI session.
        subprocess.Popen(command, env=os.environ.copy())

        print(
            f"[cotmate] opened {self.display_name} "
            f"-> {self.local_path}",
            flush=True,
        )

    # ------------------------------------------------------------------
    # Remote save
    # ------------------------------------------------------------------

    def send_save(self) -> None:
        try:
            data = self.local_path.read_bytes()
        except FileNotFoundError:
            return

        # NOTE: the body must be sent *before* the terminating blank
        # line.  The bash rmate implementation reads `data: N` and then
        # immediately reads N raw bytes; the blank line is what
        # terminates the command.
        header = (
            "save\n"
            f"token: {self.token}\n"
            f"data: {len(data)}\n"
        ).encode("utf-8")

        try:
            with self.lock:
                self.connection.sendall(header)
                self.connection.sendall(data)
                self.connection.sendall(b"\n")

            self.update_stat()

            print(
                f"[cotmate] saved {self.display_name} "
                f"({len(data)} bytes)",
                flush=True,
            )

        except (
                BrokenPipeError,
                ConnectionResetError,
                ConnectionAbortedError,
                OSError,
        ):
            self.closed = True

    # ------------------------------------------------------------------
    # Monitor
    # ------------------------------------------------------------------

    def monitor(self) -> None:
        while not self.closed:
            time.sleep(self.config.poll_interval)

            if self.changed():
                self.send_save()

    # ------------------------------------------------------------------
    # Close
    # ------------------------------------------------------------------

    def close(self, notify_remote: bool = True) -> None:
        if self.closed:
            return

        self.closed = True

        self.registry.unregister(self.registry_key, self)

        if notify_remote:
            try:
                message = (
                    "close\n"
                    f"token: {self.token}\n"
                    "\n"
                ).encode("utf-8")

                with self.lock:
                    self.connection.sendall(message)

            except OSError:
                pass

        try:
            self.local_path.unlink()
        except FileNotFoundError:
            pass
        except OSError as exc:
            print(
                f"[cotmate] unable to remove "
                f"{self.local_path}: {exc}",
                flush=True,
            )

        print(f"[cotmate] closed {self.display_name}", flush=True)


# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------

class Session:
    """
    Handles one rmate TCP connection for its whole lifetime.

    Owns the per-connection document map.  Shares the global
    DocumentRegistry with all other sessions so duplicate opens of
    the same remote file are rejected across connections.
    """

    def __init__(
            self,
            connection: socket.socket,
            address: Tuple[str, int],
            config: Config,
            registry: DocumentRegistry,
    ):
        self.connection = connection
        self.address = address
        self.config = config
        self.registry = registry

        self.documents: Dict[str, RemoteDocument] = {}

        # We only log a connection once it has sent at least one
        # command.  This keeps the `nc -z` health-check probes from
        # the launcher out of the log entirely.
        self.logged = False

    # ------------------------------------------------------------------
    # Main loop
    # ------------------------------------------------------------------

    def run(self) -> None:
        try:
            # rmate expects server identification first.
            self.connection.sendall(b"cotmate 1.0\n")

            while True:
                command, headers, body = read_command(self.connection)

                if not self.logged:
                    print(
                        f"[cotmate] connection from "
                        f"{self.address[0]}:{self.address[1]}",
                        flush=True,
                    )
                    self.logged = True

                self.handle_command(command, headers, body)

        except EOFError:
            pass

        except (
                ConnectionResetError,
                ConnectionAbortedError,
                BrokenPipeError,
        ):
            pass

        except Exception as exc:
            print(f"[cotmate] connection error: {exc}", flush=True)

        finally:
            self.close_all()

            try:
                self.connection.close()
            except OSError:
                pass

            if self.logged:
                print("[cotmate] connection closed", flush=True)

    # ------------------------------------------------------------------
    # Command dispatch
    # ------------------------------------------------------------------

    def handle_command(
            self,
            command: str,
            headers: Dict[str, str],
            body: bytes,
    ) -> None:
        if command == "." or command == "":
            # Handshake separator, or the harmless extra newline
            # that the official Ruby rmate appends after a body.
            return

        if command == "open":
            self._handle_open(headers, body)
        elif command == "save":
            self._handle_save(headers)
        elif command == "close":
            self._handle_close(headers)
        else:
            print(
                f"[cotmate] ignoring unknown command: {command}",
                flush=True,
            )

    # ------------------------------------------------------------------
    # Commands
    # ------------------------------------------------------------------

    def _handle_open(
            self,
            headers: Dict[str, str],
            body: bytes,
    ) -> None:
        token = headers.get("token", "")
        display_name = headers.get("display-name", token)
        real_path = headers.get("real-path", token)
        file_type = headers.get("file-type")

        line, column = self._parse_selection(headers.get("selection"))

        # Replace any existing doc under the same token on this connection.
        old_document = self.documents.pop(token, None)
        if old_document:
            old_document.close(notify_remote=False)

        key = (safe_host_name(display_name), real_path)

        # If another session already has this path open, close it
        # before proceeding. This handles the common case where the
        # user closed the CotEditor window for a file but CotEditor is open
        # and original rmate session is still connected — without this,
        # the second open would be rejected and the file would never reappear.
        existing = self.registry.lookup(key)
        if existing is not None and not existing.closed:
            print(
                f"[cotmate] replacing previous session for "
                f"{display_name}",
                flush=True,
            )
            existing.close(notify_remote=True)

        document = RemoteDocument(
            connection=self.connection,
            token=token,
            display_name=display_name,
            real_path=real_path,
            data=body,
            config=self.config,
            registry=self.registry,
            file_type=file_type,
            line=line,
            column=column,
        )

        # Race-free registration.  In the rare case another session
        # slipped in between lookup() and here, fall back to the
        # old rejection behaviour.
        if not self.registry.try_register(key, document):
            document.close(notify_remote=False)
            self._reject_duplicate(token, display_name)
            return

        self.documents[token] = document

        document.open_in_cot()

        monitor_thread = threading.Thread(
            target=document.monitor,
            name=f"cotmate-{token}",
            daemon=True,
        )
        monitor_thread.start()

    def _handle_save(self, headers: Dict[str, str]) -> None:
        token = headers.get("token", "")
        document = self.documents.get(token)

        if document is None:
            return

        # A remote-side save does not contain useful new data for our
        # direction of the protocol.  The data flow we care about is
        # CotEditor -> monitor -> save.  Still update the baseline so
        # the notification itself doesn't trigger unnecessary work.
        document.update_stat()

    def _handle_close(self, headers: Dict[str, str]) -> None:
        token = headers.get("token", "")
        document = self.documents.pop(token, None)

        if document:
            document.close(notify_remote=False)

    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------

    @staticmethod
    def _parse_selection(
            selection: Optional[str],
    ) -> Tuple[Optional[int], Optional[int]]:
        if not selection:
            return None, None

        parts = selection.split(",")

        try:
            line = int(parts[0])
        except (ValueError, IndexError):
            line = None

        column = None
        if len(parts) > 1:
            try:
                column = int(parts[1])
            except ValueError:
                column = None

        return line, column

    def _reject_duplicate(self, token: str, display_name: str) -> None:
        self._send_close(token)
        print(
            f"[cotmate] rejected duplicate open "
            f"of {display_name} (already open)",
            flush=True,
        )

    def _send_close(self, token: str) -> None:
        try:
            message = (
                "close\n"
                f"token: {token}\n"
                "\n"
            ).encode("utf-8")
            self.connection.sendall(message)
        except OSError:
            pass

    def close_all(self) -> None:
        """Close every document this session owns."""
        for document in self.documents.values():
            document.close(notify_remote=False)

        self.documents.clear()


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

class Server:
    """
    Owns the listening socket and the accept loop.

    Each accepted connection is handled by a Session running in its
    own daemon thread.
    """

    def __init__(self, config: Config):
        self.config = config
        self.registry = DocumentRegistry()
        self._socket: Optional[socket.socket] = None

    def bind(self) -> None:
        """Create, bind, and listen on the configured address."""
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind((self.config.host, self.config.port))
        sock.listen(20)
        self._socket = sock

    def serve_forever(self) -> None:
        """Accept connections until interrupted."""
        assert self._socket is not None, "bind() must be called first"

        while True:
            connection, address = self._socket.accept()

            session = Session(
                connection=connection,
                address=address,
                config=self.config,
                registry=self.registry,
            )

            thread = threading.Thread(
                target=session.run,
                name=f"cotmate-session-{address[1]}",
                daemon=True,
            )
            thread.start()

    def shutdown(self) -> None:
        if self._socket is None:
            return

        try:
            self._socket.close()
        except OSError:
            pass

        self._socket = None


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> None:
    parser = argparse.ArgumentParser(
        description="rmate-compatible TCP server for CotEditor"
    )

    parser.add_argument(
        "--host",
        default=DEFAULT_HOST,
        help=f"Listen address (default: {DEFAULT_HOST})",
    )

    parser.add_argument(
        "--port",
        type=int,
        default=DEFAULT_PORT,
        help=f"Listen port (default: {DEFAULT_PORT})",
    )

    parser.add_argument(
        "--pidfile",
        type=pathlib.Path,
        default=None,
        help="Write the server PID to this file",
    )

    parser.add_argument(
        "--version",
        action="version",
        version=f"CotMate {__version__}",
    )

    args = parser.parse_args()

    config = Config.from_args(args)

    config.base_dir.mkdir(parents=True, exist_ok=True)
    config.mirrors_dir.mkdir(parents=True, exist_ok=True)

    print(f"[cotmate] CotMate {__version__}", flush=True)
    print(f"[cotmate] environment: {environment_report()}", flush=True)

    # Wipe leftovers from previous runs before we start serving.
    cleanup_stale_mirrors(config.mirrors_dir)

    # Verify CotEditor CLI before starting.
    cot = find_cot()
    print(f"[cotmate] using cot: {cot}", flush=True)

    server = Server(config)
    server.bind()

    # Only claim the pidfile once we're actually serving.  This way a
    # failed bind cannot leave a stale pidfile behind.
    if args.pidfile:
        args.pidfile.parent.mkdir(parents=True, exist_ok=True)
        args.pidfile.write_text(str(os.getpid()))

    print(
        f"[cotmate] listening on {config.host}:{config.port}",
        flush=True,
    )

    # noinspection PyUnusedLocal,unused-parameter
    def shutdown(signum, frame):
        print("[cotmate] received SIGTERM, shutting down", flush=True)
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, shutdown)

    try:
        server.serve_forever()

    except KeyboardInterrupt:
        print("\n[cotmate] shutting down", flush=True)

    finally:
        server.shutdown()

        if args.pidfile:
            try:
                args.pidfile.unlink()
            except FileNotFoundError:
                pass
            except OSError:
                pass


if __name__ == "__main__":
    main()
